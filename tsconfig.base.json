{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@repo/shared-types/*": ["packages/shared-types/src/*"],
      "@repo/shared-types": ["packages/shared-types/src"],
      "@repo/db": ["packages/db"]
    }
  }
}